{
  "$ref": "#/definitions/quiz",
  "definitions": {
    "quiz": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "categoryName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "default": "SD"
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "Mudah",
            "Sedang",
            "Sulit"
          ],
          "default": "Sedang"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shuffleCount": {
          "type": "number",
          "default": 5
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "questionText": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "enum": [
                        "A",
                        "B",
                        "C",
                        "D",
                        "E"
                      ]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2
              },
              "correctAnswer": {
                "type": "string"
              },
              "explanation": {
                "type": "string"
              },
              "difficulty": {
                "type": "string",
                "enum": [
                  "Mudah",
                  "Sedang",
                  "Sulit"
                ],
                "default": "Mudah"
              }
            },
            "required": [
              "id",
              "questionText",
              "options",
              "correctAnswer",
              "explanation"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "duration",
        "questions"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}