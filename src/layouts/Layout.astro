---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'AsahOtak - Bank latihan soal harian untuk siswa kelas 1 sampai 4 SD lengkap dengan kunci jawaban dan pembahasan.',
} = Astro.props;
---

<!doctype html>
<html lang="id" class="h-full bg-slate-100/70 text-slate-900 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | AsahOtak</title>
    <meta name="description" content={description} />

    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <!-- KaTeX CSS untuk rumus Matematika & IPA -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      crossorigin="anonymous"
    />

    <style is:global>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      .katex {
        font-size: 1.05em;
        line-height: 1.3;
      }
      .katex-display {
        margin: 0.6rem 0 !important;
      }
    </style>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-100/70 text-slate-800">
    <Header />
    <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8 max-w-6xl mx-auto w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
