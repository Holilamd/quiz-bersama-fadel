---
import type { SubjectCategory } from '../utils/categories';

interface Props {
  category: SubjectCategory;
  quizCount: number;
}

const { category, quizCount } = Astro.props;
---

<a
  href={`/quiz/${category.slug}`}
  class="group flex flex-col justify-between p-5 bg-white rounded-xl border border-slate-200 hover:border-blue-400 hover:shadow-sm transition"
>
  <div>
    <!-- Category Header & Icon -->
    <div class="flex items-center justify-between mb-3.5">
      <div
        class={`w-10 h-10 rounded-lg ${category.solidColor || 'bg-slate-700'} flex items-center justify-center text-white`}
      >
        {category.slug === 'matematika' && (
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="16" height="20" x="4" y="2" rx="2"></rect>
            <line x1="8" x2="16" y1="6" y2="6"></line>
            <line x1="16" x2="16" y1="14" y2="18"></line>
            <path d="M16 10h.01"></path>
            <path d="M12 10h.01"></path>
            <path d="M8 10h.01"></path>
            <path d="M12 14h.01"></path>
            <path d="M8 14h.01"></path>
          </svg>
        )}
        {category.slug === 'ipa' && (
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(45 12 12)"></ellipse>
            <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(-45 12 12)"></ellipse>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
        )}
        {category.slug === 'bahasa' && (
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
            <path d="M6 6h10"></path>
            <path d="M6 10h10"></path>
          </svg>
        )}
        {category.slug === 'tematik' && (
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
          </svg>
        )}
      </div>

      <span class="text-xs font-semibold px-2.5 py-0.5 rounded bg-slate-100 text-slate-600">
        {quizCount} Topik
      </span>
    </div>

    <!-- Title & Desc -->
    <h3 class="text-base font-bold text-slate-900 group-hover:text-blue-700 transition">
      {category.name}
    </h3>
    <p class="text-xs text-slate-500 mt-1.5 line-clamp-2 leading-relaxed">
      {category.description}
    </p>
  </div>

  <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-blue-700">
    <span>Lihat Soal</span>
    <span aria-hidden="true">&rarr;</span>
  </div>
</a>
